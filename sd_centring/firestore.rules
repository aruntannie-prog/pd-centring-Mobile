rules_version = '2';

// SD Centring database rules. Deploy with:  firebase deploy --only firestore:rules
//
// Access requires BOTH:
//   1. signing in with an account created by the owner, and
//   2. a document at staff/{uid} (added by the owner in the Firebase console).
// Checking only "signed in" is not enough: the web API key is public, so
// anyone could create an account through the Firebase REST API.
//
// These rules have no expiry date. (Rules created in "test mode" expire
// after 30 days and then silently block every save.)
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isDay(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Staff list: managed only from the Firebase console.
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Optional text field: absent, or a string no longer than max.
    // Limits are well above the form's (which counts letters, not code
    // points), so they only stop junk, never a real customer.
    function optText(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    function validCustomer(d) {
      return d.name is string
        && d.name.size() > 0 && d.name.size() <= 400
        && d.phone is string
        && d.phone.size() >= 10 && d.phone.size() <= 16
        && optText(d, 'altPhone', 16)
        && optText(d, 'address', 4000)
        && optText(d, 'notes', 8000)
        && optText(d, 'photoUrl', 2048)
        && optText(d, 'photoThumbUrl', 2048)
        // Files live in Storage; only small records are kept here.
        && (!('documents' in d) || (d.documents is list && d.documents.size() <= 30))
        && d.createdAt is int;
    }

    match /customers/{id} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff() && validCustomer(request.resource.data);
    }

    match /rentals/{id} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.dcNumber is string
        && request.resource.data.dcNumber.size() > 0
        && request.resource.data.customerId is string
        && isDay(request.resource.data.issuedOn)
        && isDay(request.resource.data.expiresOn)
        && request.resource.data.expiresOn >= request.resource.data.issuedOn
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.returns is list;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
